{
  "capabilities": {
    "local-obstacle-avoidance": {
      "host": "http://localhost:8008",
      "port": 8008,
      "repo": "https://github.com/Beethoven-Q/local-obstacle-avoidance",
      "description": "Real-time local obstacle avoidance for mobile base using depth camera. VFH-based safe velocity, emergency stop.",
      "client_sdk": "https://raw.githubusercontent.com/Beethoven-Q/local-obstacle-avoidance/master/client.py",
      "endpoints": [
        "POST /update",
        "POST /command",
        "GET /costmap",
        "GET /estop",
        "GET /health"
      ]
    },
    "graspgen": {
      "host": "http://localhost:8002",
      "port": 8002,
      "repo": "https://github.com/Selina22/graspgen",
      "description": "6-DOF grasp pose generation using Contact-GraspNet. Accepts depth image or point cloud, returns ranked grasp poses as 4x4 homogeneous transforms with quality scores.",
      "client_sdk": "https://raw.githubusercontent.com/Selina22/graspgen/master/client.py",
      "endpoints": [
        "POST /predict",
        "GET /health"
      ],
      "usage": {
        "import": "from client import Client",
        "init": "c = Client(\"http://localhost:8002\")",
        "example": "result = c.predict(depth_image=img_bytes, K=[fx,0,cx,0,fy,cy,0,0,1])",
        "returns": "{\"grasps\": [{\"transform\": 4x4, \"score\": float, \"contact_point\": [x,y,z], \"gripper_opening\": float}], \"num_grasps\": int, \"inference_time_ms\": float}"
      }
    }
  }
}